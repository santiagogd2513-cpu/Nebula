<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/nebula_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nebula_bottom_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEBULA"
                android:textColor="@color/nebula_accent"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.22"
                android:fontFamily="sans" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tu mundo.\nTus reglas."
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:textSize="30sp"
                android:lineSpacingExtra="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                android:text="Minecraft Java Edition · Launcher para Android"
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_px_book"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Novedades y comunidad"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_social_media"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Comunidad Nebula"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_px_gamepad"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Controles de juego"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_px_java_run"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Instalar complemento JAR"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_px_sharelog"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Compartir registros"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/nebula_menu_card"
                android:drawableStart="@drawable/ic_px_folder"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="Archivos del juego"
                android:textColor="@color/primary_text" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/nebula_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_bottom_bar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="16dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="34dp"
                app:drawableEndPadding="2dp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/nebula_menu_card"
                android:contentDescription="Editar perfil"
                android:padding="12dp"
                android:src="@drawable/ic_px_edit" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="JUGAR"
            android:textAllCaps="true"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
